FROM node:18-alpine

WORKDIR /app

COPY package*.json ./

RUN npm install --no-audit --no-fund

COPY . .

ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL

# ДЕТАЛЬНАЯ ДИАГНОСТИКА
RUN echo "=== VITE_API_URL during build ===" && echo $VITE_API_URL
RUN echo "=== Current directory ===" && pwd
RUN echo "=== Checking files ===" && find . -name "*.tsx" -o -name "*.ts" | grep -E "(main|app|meetings)" | head -10

# Попробуем собрать с подробным выводом
RUN npm run build 2>&1 || (echo "=== BUILD FAILED ===" && exit 1)

EXPOSE 4173

CMD ["npm", "run", "serve"]